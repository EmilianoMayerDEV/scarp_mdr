# Copia este archivo como ".env" y rellena tus datos. Nunca subas el .env a GitHub.

# --- Fuentes de negocios ---
# Clave de Google Places API (New). Si la dejas vacía, solo se usa OpenStreetMap.
GOOGLE_PLACES_API_KEY=

# --- Verificación en la web (opcional) ---
# Clave de Brave Search API para buscar el nombre del negocio en internet.
# Sin ella se verifica igualmente con la web de la ficha y probando dominios típicos.
BRAVE_API_KEY=

# --- Tu firma en los mensajes ---
FIRMA_NOMBRE=Emiliano Mayer
FIRMA_EMPRESA=Mayer Digital
FIRMA_WEB=mayerdigital.website
FIRMA_TELEFONO=

# Dónde están publicadas las webs modelo (se añade el enlace del sector en cada mensaje).
# Déjalo vacío para no incluir enlace.
MODELOS_URL=https://mayerdigital.website/modelos

# --- Correo (Hostinger) para enviar los emails desde el panel ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USUARIO=
SMTP_CONTRASENA=
# Recibe una copia oculta de cada correo enviado (recomendado, así quedan en tu bandeja)
SMTP_COPIA_A_MI=si

# --- Límites ---
# Máximo de mensajes (email + WhatsApp) por día. Empieza bajo: tu dominio es nuevo.
LIMITE_DIARIO=15
# Días tras los que un negocio contactado aparece en "pendientes de seguimiento"
DIAS_SEGUIMIENTO=5
